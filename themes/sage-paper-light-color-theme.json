  "tokenColors": [
    {
      "name": "Default foreground",
      "scope": [
        "source",
        "text"
      ],
      "settings": {
        "foreground": "#243A30"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#5B7063",
        "fontStyle": ""
      }
    },
    {
      "name": "Keywords and storage",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "storage",
        "storage.type",
        "storage.modifier",
        "variable.language.this",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#88436E"
      }
    },
    {
      "name": "Operators and punctuation",
      "scope": [
        "keyword.operator",
        "keyword.operator.word",
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#52665A"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.unquoted",
        "meta.embedded.assembly"
      ],
      "settings": {
        "foreground": "#A14E53"
      }
    },
    {
      "name": "String escapes and interpolation punctuation",
      "scope": [
        "constant.character.escape",
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#82620E"
      }
    },
    {
      "name": "Numbers and booleans",
      "scope": [
        "constant.numeric",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#2D7048"
      }
    },
    {
      "name": "Constants and enum members",
      "scope": [
        "constant",
        "variable.other.constant",
        "variable.other.enummember",
        "support.constant"
      ],
      "settings": {
        "foreground": "#246C6B"
      }
    },
    {
      "name": "Variables, parameters, and properties",
      "scope": [
        "variable",
        "variable.parameter",
        "variable.other",
        "meta.definition.variable.name",
        "entity.name.variable",
        "support.variable",
        "meta.object-literal.key",
        "support.type.property-name",
        "support.type.property-name.json",
        "meta.structure.dictionary.key"
      ],
      "settings": {
        "foreground": "#246C6B"
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function",
        "variable.function",
        "entity.name.operator.custom-literal"
      ],
      "settings": {
        "foreground": "#82620E"
      }
    },
    {
      "name": "Types, classes, interfaces, and namespaces",
      "scope": [
        "support.class",
        "support.type",
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "storage.type.numeric",
        "storage.type.byte",
        "storage.type.boolean",
        "storage.type.string",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#206B5C"
      }
    },
    {
      "name": "Decorators and annotations",
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#82620E"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#2D7048"
      }
    },
    {
      "name": "Tag attributes",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.html",
        "entity.other.attribute-name.xml",
        "entity.other.attribute-name.jsx"
      ],
      "settings": {
        "foreground": "#246C6B"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp",
        "constant.regexp"
      ],
      "settings": {
        "foreground": "#A14E53"
      }
    },
    {
      "name": "Preprocessor and macros",
      "scope": [
        "meta.preprocessor",
        "entity.name.function.preprocessor",
        "keyword.control.directive",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#88436E"
      }
    },
    {
      "name": "Labels",
      "scope": [
        "entity.name.label",
        "entity.name.label.cs"
      ],
      "settings": {
        "foreground": "#88436E"
      }
    },
    {
      "name": "Invalid and deprecated",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#AA3C36"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#206B5C",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "meta.link.inline.markdown"
      ],
      "settings": {
        "foreground": "#206B5C"
      }
    },
    {
      "name": "Markdown inline code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#805D0E"
      }
    },
    {
      "name": "Markdown quote and list punctuation",
      "scope": [
        "punctuation.definition.quote.begin.markdown",
        "punctuation.definition.list.begin.markdown"
      ],
      "settings": {
        "foreground": "#5C7163"
      }
    },
    {
      "name": "Markup bold",
      "scope": [
        "markup.bold",
        "strong"
      ],
      "settings": {
        "foreground": "#243A30",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup italic",
      "scope": [
        "markup.italic",
        "emphasis"
      ],
      "settings": {
        "foreground": "#52665A",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file"
      ],
      "settings": {
        "foreground": "#2D7048"
      }
    },
    {
      "name": "Diff removed",
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file"
      ],
      "settings": {
        "foreground": "#AA3C36"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed",
        "meta.diff.range"
      ],
      "settings": {
        "foreground": "#906A0D"
      }
    },
    {
      "name": "Embedded code and Java declarations",
      "scope": [
        "meta.embedded",
        "source.groovy.embedded",
        "meta.template.expression",
        "source.coffee.embedded",
        "storage.modifier.import.java",
        "variable.language.wildcard.java",
        "storage.modifier.package.java"
      ],
      "settings": {
        "foreground": "#243A30"
      }
    },
    {
      "name": "Language-specific strings and regex characters",
      "scope": [
        "string meta.image.inline.markdown",
        "meta.preprocessor.string",
        "string.comment.buffered.block.pug",
        "string.quoted.pug",
        "string.interpolated.pug",
        "string.unquoted.plain.in.yaml",
        "string.unquoted.plain.out.yaml",
        "string.unquoted.block.yaml",
        "string.quoted.single.yaml",
        "string.quoted.double.xml",
        "string.quoted.single.xml",
        "string.unquoted.cdata.xml",
        "string.quoted.double.html",
        "string.quoted.single.html",
